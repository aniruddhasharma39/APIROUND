# DeskFlow Backend — Environment Variables

# MongoDB connection string
# Local: mongodb://localhost:27017/deskflow
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/deskflow
MONGO_URI=

# Port the Express server listens on (default: 5000)
PORT=5000

# Comma-separated list of allowed frontend origins (added to localhost defaults)
# Example: https://your-app.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=
